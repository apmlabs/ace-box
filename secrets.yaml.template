# ACE-Box Secrets Template
# Copy this file to secrets.yaml and fill in your Dynatrace credentials
# NEVER commit secrets.yaml to version control

# Dynatrace Environment Configuration
dt_environment_url_gen3: "https://YOUR_TENANT.live.dynatrace.com"
dt_api_token: "dt0c01.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# Optional: Dynatrace Data Ingest Token (if different from API token)
# dt_data_ingest_token: "dt0c01.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# AWS Configuration (optional - can use AWS CLI profile instead)
# aws_access_key_id: "AKIAXXXXXXXXXXXXXXXX"
# aws_secret_access_key: "XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
# aws_region: "us-east-2"

# ACE-Box Configuration
name_prefix: "acebox"
owner_email: "user@example.com"
resource_tags:
  Environment: "demo"
  Project: "acebox"
instance_type: "c5.2xlarge"
disk_size: 60
use_case_url: "https://github.com/dynatrace-ace/basic-dt-demo.git"
